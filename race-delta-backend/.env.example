FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-key-change
DATABASE_URL=sqlite:///racedelta.db

# Phase 5 - AI Race Analyst (optional). Without a key the analyst runs in offline intent mode.
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5

# ...or run the analyst on an NVIDIA-hosted model (takes precedence over ANTHROPIC_API_KEY).
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b   # e.g. moonshotai/kimi-k3 when your account has it


# Analyst latency knobs (shared NVIDIA endpoint occasionally stalls a request)
NVIDIA_TIMEOUT=25
NVIDIA_ATTEMPTS=2
NVIDIA_REASONING_EFFORT=low
